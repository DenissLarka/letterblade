<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.druvu</groupId>
	<artifactId>letterblade</artifactId>
	<version>1.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>DRUVU.COM / LETTERBLADE</name>
	<description>Desktop viewer for Outlook .msg files - no Outlook required. A JavaFX application on druvu-lib-fx.</description>

	<developers>
		<developer>
			<name>Deniss LARKA</name>
			<email>deniss.larka@gmail.com</email>
		</developer>
	</developers>

	<!-- letterblade-dist bundles this artifact into the installer images, so it must exist as one
	     canonical binary per release rather than being rebuilt on each dist box (house rule
	     2026-08-16). Published by .github/workflows/maven-github-publish.yml on release; v1.0.0 was
	     published by hand from its tag, after the fact. -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/DenissLarka/letterblade/</url>
		</repository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Java 27 (STS) since 2026-10-13, with the kit: AtlantaFX 3 needs JavaFX 27, and JavaFX is the
		     JDK's. Cost accepted with the FX layer (2026-10-04): a JDK step - and a three-OS installer
		     re-release - every six months until the next LTS. -->
		<java.version>27</java.version>

		<!-- Spotless (palantir) is OFF while the build runs on JDK 27, as in the kit: palantir-java-format
		     crashes there (NoSuchFieldError JCCompilationUnit.endPositions -
		     https://github.com/palantir/palantir-java-format/issues/1785); measured 2026-10-13 with 2.102.0,
		     the newest release, still failing. Until a release supports 27: format from a JDK 25 shell,
		     `mvn spotless:apply` - the goal alone, which compiles nothing. To re-enable: delete this property
		     and bump palantir-java-format.version to the release that fixed it. -->
		<spotless.check.skip>true</spotless.check.skip>

		<!-- JavaFX comes from the JDK (Azul Zulu FX): there are deliberately NO org.openjfx
		     dependencies - the app ships its JDK via the druvu install pipeline, so the fx modules
		     are version-locked to the JDK. -->

		<!-- application dependencies -->
		<!-- The kit's main as a SNAPSHOT, built from source: `mvn install` in the druvu-lib-fx clone
		     puts it in .m2 (there is no remote for SNAPSHOTs - GitHub Packages holds releases only).
		     CI mirrors that by checking out the kit's main and installing it. The coupling is real:
		     this property must say what the kit's main pom says, or resolution fails. Before any
		     official installer the kit is released and this is pinned to that tag again (no-SNAPSHOT
		     rule, 2026-08-14) - with the ref in .github/workflows/ci.yml moved back to the tag. -->
		<druvu-lib-fx.version>1.0.2-SNAPSHOT</druvu-lib-fx.version>
		<outlook-message-parser.version>1.16.2</outlook-message-parser.version>
		<jsoup.version>1.23.2</jsoup.version>
		<slf4j.version>2.0.20</slf4j.version>

		<!-- test -->
		<testng.version>7.12.0</testng.version>
		<assertj.version>3.27.7</assertj.version>

		<!-- plugins -->
		<maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		<spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
		<spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
		<palantir-java-format.version>2.90.0</palantir-java-format.version>
		<javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
		<asm.version>9.11.1</asm.version>
	</properties>

	<repositories>
		<repository>
			<id>github</id>
			<name>GitHub Packages (druvu-lib-fx)</name>
			<url>https://maven.pkg.github.com/DenissLarka/druvu-lib-fx/</url>
		</repository>
	</repositories>

	<dependencies>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- druvu JavaFX toolkit (consumed from local .m2 until the delivery-pipeline switch) -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>druvu-lib-fx</artifactId>
			<version>${druvu-lib-fx.version}</version>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- .msg PARSING -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.simplejavamail</groupId>
			<artifactId>outlook-message-parser</artifactId>
			<version>${outlook-message-parser.version}</version>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- HTML sanitize + cid-rewrite + html->text -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>${jsoup.version}</version>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- LOG - api at compile (lib-fx requires org.slf4j, provided/non-transitive), simple
		     binding at runtime. Mirrors druvu-lib-fx-example. -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>${slf4j.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- TEST - druvu-lib-fx uses TestNG + AssertJ, NOT JUnit -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>${testng.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- slf4j-simple is declared once at runtime scope above; runtime deps are on the test
		     classpath too, so tests get a logging binding without a second declaration. -->
	</dependencies>

	<build>
		<plugins>
			<!-- maven-compiler-plugin: J27. No lombok annotation processor (lombok is not used here). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven-compiler-plugin.version}</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<release>${java.version}</release>
					<debug>true</debug>
					<showDeprecation>true</showDeprecation>
					<showWarnings>true</showWarnings>
					<compilerArgs>
						<arg>-parameters</arg>
						<!-- Stamps the module descriptor: VersionExtractor reads it under jlink,
						     where there is no jar manifest - without it the updater sees 0.0.0. -->
						<arg>--module-version=${project.version}</arg>
					</compilerArgs>
				</configuration>
			</plugin>

			<!-- maven-surefire-plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven-surefire-plugin.version}</version>
				<configuration>
					<!-- Run tests on the classpath, not the module-path: the JDK-bundled JavaFX
					     system modules stay visible to unnamed-module test code. module-info.java is
					     still validated during compilation. This setting is load-bearing. -->
					<useModulePath>false</useModulePath>
				</configuration>
			</plugin>

			<!-- spotbugs-maven-plugin -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-maven-plugin.version}</version>
				<dependencies>
					<!-- updated asm to support J27 -->
					<dependency>
						<groupId>org.ow2.asm</groupId>
						<artifactId>asm</artifactId>
						<version>${asm.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<xmlOutput>true</xmlOutput>
					<includeTests>false</includeTests>
					<!-- project.basedir, not maven.multiModuleProjectDirectory: the latter is resolved by the
					     Maven launcher from the WORKING directory, so `mvn -f <path>` from elsewhere points it
					     at the wrong repo and the build dies on a missing filter file. This project is a
					     single module, so its own basedir is the honest answer. -->
					<excludeFilterFile>${project.basedir}/_spotbug-filters/spotbug-exclude.xml</excludeFilterFile>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- maven-pmd-plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${maven-pmd-plugin.version}</version>
				<dependencies>
					<!-- updated asm to support J27 -->
					<dependency>
						<groupId>org.ow2.asm</groupId>
						<artifactId>asm</artifactId>
						<version>${asm.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<printFailingErrors>true</printFailingErrors>
					<failurePriority>3</failurePriority>
					<includeTests>true</includeTests>
					<linkXRef>false</linkXRef>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
							<goal>cpd-check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- spotless: house code formatter (same config as jconsole-booster / druvu-lib-jmxmp).
			     `mvn spotless:apply` reformats; `check` runs in verify and fails on unformatted code. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
							<style>PALANTIR</style>
							<formatJavadoc>true</formatJavadoc>
						</palantirJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>

			<!-- javafx-maven-plugin: run only (mvn javafx:run). JavaFX modules come from the JDK. -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>${javafx-maven-plugin.version}</version>
				<configuration>
					<mainClass>com.druvu.letterblade/com.druvu.letterblade.LetterbladeApp</mainClass>
					<!-- JEP 472: JavaFX 27 loads native libraries, which the JDK warns about and will block in
					     a future release unless the modules are granted native access. The dist launcher needs
					     the same flag in its jvmOptions. -->
					<options>
						<option>--enable-native-access=javafx.graphics,javafx.web</option>
					</options>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
